# ==============================================================================
# StatementFlow AI — Environment Configuration (.env.local)
# Works out-of-the-box with ZERO keys in Keyless Demo & Heuristic Mode.
# ==============================================================================

# 1. Optional: Upstream OpenAI-Compatible LLM API (OpenAI / DeepSeek / DashScope / Ollama)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="15000"

# 2. Optional: Creem.io Merchant of Record (Recommended for Global Tax & Payout Compliance)
CREEM_API_KEY=""
CREEM_PRODUCT_ID_PRO=""
CREEM_PRODUCT_ID_BUSINESS=""
CREEM_WEBHOOK_SECRET=""

# 3. Optional: Stripe Global Checkout
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# 4. Public Application URL (Used for checkout redirect callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
